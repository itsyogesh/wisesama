generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Core entity types
enum EntityType {
  ADDRESS
  DOMAIN
  TWITTER
  EMAIL
}

enum RiskLevel {
  SAFE // Verified/Whitelisted (score 0-19)
  UNKNOWN // No data (score: null)
  CAUTION // Suspicious (score 40-69)
  FRAUD // Confirmed malicious (score 70-100)
}

enum ThreatCategory {
  PHISHING
  SCAM
  RUG_PULL
  IMPERSONATION
  FAKE_AIRDROP
  RANSOMWARE
  MIXER
  OFAC_SANCTIONED
  OTHER
}

// Identity source for unified identity storage
enum IdentitySource {
  POLKADOT_PEOPLE // Polkadot People Chain identity
  KUSAMA_PEOPLE // Kusama People Chain identity
  KILT // KILT DID (future support)
}

// Whitelist request workflow status
enum WhitelistRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Activity types for audit logging
enum ActivityType {
  WHITELIST_CREATED
  WHITELIST_UPDATED
  WHITELIST_DELETED
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REPORT_VERIFIED
  REPORT_REJECTED
  SYNC_COMPLETED
  ADMIN_LOGIN
}

model Chain {
  id                  Int                 @id @default(autoincrement())
  code                String              @unique // 'dot', 'ksm', 'astr'
  name                String // 'Polkadot', 'Kusama'
  ss58Prefix          Int
  rpcEndpoint         String?
  explorerUrl         String?
  isActive            Boolean             @default(true)
  entities            Entity[]
  identities          Identity[]          @relation("identities")
  whitelistedEntities WhitelistedEntity[]
  whitelistRequests   WhitelistRequest[]
}

model Entity {
  id              String     @id @default(cuid())
  entityType      EntityType
  value           String // Original value
  normalizedValue String // Lowercase/normalized
  chainId         Int?
  chain           Chain?     @relation(fields: [chainId], references: [id])

  // Risk assessment
  riskLevel      RiskLevel       @default(UNKNOWN)
  riskScore      Int? // 0-100
  threatCategory ThreatCategory?

  // Source tracking
  source     String  @default("unknown")
  sourceUrl  String? // Related phishing URL
  threatName String? // Category from phishing list

  // Stats
  timesSearched   Int       @default(0)
  lastSearchedAt  DateTime?
  userReportCount Int       @default(0)

  // Timestamps
  firstReportedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reports  Report[]
  searches Search[]
  comments EntityComment[]

  @@unique([entityType, normalizedValue])
  @@index([normalizedValue])
  @@index([riskLevel])
  @@index([source])
}

// Unified identity table supporting multiple sources (People chains, KILT, etc.)
model Identity {
  id      String         @id @default(cuid())
  address String
  source  IdentitySource

  // Optional chain relation (for filtering by ecosystem)
  chainId Int?
  chain   Chain? @relation("identities", fields: [chainId], references: [id])

  // Identity fields (normalized on write)
  displayName String?
  legalName   String?
  email       String?
  twitter     String? // Normalized: lowercase, no @ prefix
  web         String? // Normalized: lowercase, no protocol/www
  riot        String?

  // Additional social fields (from info.additional key-value pairs)
  github           String? // Normalized: lowercase, no @ or URL prefix
  discord          String?
  matrix           String? // Matrix/Element handle
  image            String? // From info.image
  pgpFingerprint   String? // From info.pgpFingerprint
  additionalFields Json    @default("{}") // All additional k/v pairs as catch-all

  // KILT-specific fields (for future use)
  kiltDid           String?
  kiltCredentialUri String?

  // Verification
  hasIdentity Boolean @default(false)
  isVerified  Boolean @default(false)
  judgements  Json    @default("[]") // [{registrar_id, judgement}]

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Composite unique: same address can have identities from different sources
  @@unique([address, source])
  @@index([address])
  @@index([source])
  @@index([isVerified])
  @@index([twitter]) // For reverse lookups
  @@index([web]) // For reverse lookups
  @@index([twitter, isVerified])
  @@index([web, isVerified])
  @@index([github])
  @@index([github, isVerified])
  @@index([lastSyncedAt])
}

enum UserRole {
  USER
  ADMIN
}

model User {
  personalOrganization            Organization?                 @relation("PersonalOrganization")
  createdOrganizations            Organization[]                @relation("OrganizationCreator")
  organizationMemberships         OrganizationMember[]
  organizationInvitationsCreated  OrganizationInvitation[]      @relation("OrganizationInvitationCreator")
  organizationInvitationsAccepted OrganizationInvitation[]      @relation("OrganizationInvitationAcceptor")
  organizationAudit               OrganizationAudit[]           @relation("OrganizationAuditActor")
  organizationAuditTargets        OrganizationAudit[]           @relation("OrganizationAuditTarget")
  intelAdmin                      Boolean                       @default(false)
  intelSuspendedAt                DateTime?
  intelSuspensionReason           String                        @default("")
  intelRevision                   Int                           @default(0)
  intelAdminAudit                 IntelAdminAudit[]
  playbookResponses               SecurityPlaybookResponse[]
  playbookEvents                  SecurityPlaybookEvent[]
  repositoryConnections           RepositoryConnection[]
  repositoryConnectionAttempts    RepositoryConnectionAttempt[]
  repositorySources               ProjectRepositorySource[]
  id                              String                        @id @default(cuid())
  email                           String                        @unique
  name                            String?
  image                           String?
  emailVerified                   Boolean                       @default(false)
  role                            UserRole                      @default(USER)

  // Quota
  remainingQuota Int    @default(100)
  tier           String @default("free")

  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // App relations
  apiKeys               ApiKey[]
  reports               Report[]
  searches              Search[]
  watchedAddresses      WatchedAddress[]
  whitelistRequests     WhitelistRequest[]
  securityProjects      SecurityProject[]
  securityNotifications SecurityNotificationSettings?
  securityDeliveries    SecurityDelivery[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  keyHash   String  @unique // SHA256 hash
  keyPrefix String // First 8 chars for display
  name      String?

  remainingQuota  Int @default(10000)
  rateLimitPerMin Int @default(60)

  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([keyHash])
}

model Report {
  id       String  @id @default(cuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  reportedValue  String
  entityType     EntityType
  threatCategory ThreatCategory
  otherCategory  String?
  description    String?
  relatedUrl     String?
  evidenceUrls   String[]       @default([])

  // Reporter info (if not logged in)
  reporterName  String?
  reporterEmail String?

  status     String    @default("pending") // pending, verified, rejected
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Community contribution (auto-PR to polkadot-js/phishing)
  contribution CommunityContribution?

  @@index([status])
  @@index([entityType])
}

// Track PRs submitted to polkadot-js/phishing repository
model CommunityContribution {
  id       String @id @default(cuid())
  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id])

  // GitHub PR info
  prNumber Int?
  prUrl    String?
  prStatus String  @default("pending") // pending, open, merged, closed, error

  // What was contributed
  entityType  EntityType
  entityValue String
  targetFile  String // "address.json" or "all.json"

  // Tracking
  submittedAt  DateTime?
  mergedAt     DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prStatus])
}

model Search {
  id             String      @id @default(cuid())
  searchTerm     String
  normalizedTerm String
  entityType     EntityType?
  entityId       String?
  entity         Entity?     @relation(fields: [entityId], references: [id])

  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  apiKeyUsed String?

  resultRisk     RiskLevel?
  responseTimeMs Int?
  cacheHit       Boolean    @default(false)

  searchedAt DateTime @default(now())

  @@index([searchedAt])
  @@index([normalizedTerm])
}

model WatchedAddress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  address    String
  chain      String  @default("dot")
  webhookUrl String?

  isActive    Boolean   @default(true)
  lastAlertAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, address, chain])
  @@index([address])
}

model EntityComment {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  comment     String
  authorName  String?
  authorEmail String?

  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([entityId])
}

model SyncState {
  id               String    @id @default(cuid())
  sourceName       String    @unique // 'polkadot-js-phishing'
  lastSyncAt       DateTime?
  lastSyncHash     String? // Content hash for change detection
  recordsProcessed Int       @default(0)
  lastError        String?
  metadata         Json      @default("{}")
}

// Ecosystem Whitelist - Top projects, validators, exchanges
model WhitelistedEntity {
  id              String     @id @default(cuid())
  entityType      EntityType
  value           String // Address, domain, handle
  normalizedValue String
  chainId         Int?
  chain           Chain?     @relation(fields: [chainId], references: [id])

  // Entity info
  name        String // "Polkadot Treasury", "Parity Technologies"
  category    String // "exchange", "validator", "treasury", "project"
  description String?
  website     String?
  twitter     String?
  logoUrl     String?

  // Verification
  source     String // "manual", "governance", "subscan", "request"
  verifiedAt DateTime?
  verifiedBy String? // Admin who verified

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relation to approval request (if created via request workflow)
  whitelistRequest WhitelistRequest?

  @@unique([entityType, normalizedValue])
  @@index([category])
  @@index([name])
}

// Whitelist request workflow - public submissions for whitelist inclusion
model WhitelistRequest {
  id String @id @default(cuid())

  // Entity details
  entityType      EntityType
  value           String
  normalizedValue String
  chainId         Int?
  chain           Chain?     @relation(fields: [chainId], references: [id])

  // Project/Entity info
  name        String
  category    String // project, validator, exchange, etc.
  description String?
  website     String?
  twitter     String?
  logoUrl     String?

  // Requester info - supports both anonymous and logged-in users
  userId         String? // Link to User if logged in
  user           User?   @relation(fields: [userId], references: [id])
  requesterName  String? // Fallback for anonymous
  requesterEmail String // Required for notifications
  requesterOrg   String?

  // Evidence for verification
  evidenceUrls      String[] @default([])
  verificationNotes String?

  // Review workflow
  status          WhitelistRequestStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     String?
  rejectionReason String?

  // Link to created entity (if approved)
  whitelistedEntityId String?            @unique
  whitelistedEntity   WhitelistedEntity? @relation(fields: [whitelistedEntityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([requesterEmail])
  @@index([createdAt])
}

// Audit trail for admin actions
model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  userId      String?
  userEmail   String?
  entityType  String?
  entityId    String?
  metadata    Json         @default("{}")
  ipAddress   String?
  createdAt   DateTime     @default(now())

  @@index([type])
  @@index([createdAt])
}

// Vulnerability response lives alongside the original crypto product.
// Inventories are private to the owning account; advisory records are public.
model SecurityProject {
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playbookResponses  SecurityPlaybookResponse[]
  internetFacing     String                     @default("unknown")
  sensitiveData      String                     @default("unknown")
  hosting            String                     @default("")
  contextUpdatedAt   DateTime?
  repositorySource   ProjectRepositorySource?
  id                 String                     @id @default(cuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  environment        String                     @default("production")
  packages           Json                       @default("[]")
  runtime            Json?
  inventoryRevision  String                     @default(cuid())
  inventoryUpdatedAt DateTime                   @default(now())
  lastScannedAt      DateTime?
  nextScanAt         DateTime                   @default(now())
  scanError          String?
  scanToken          String?
  scanStartedAt      DateTime?
  sources            Json                       @default("[]")
  warnings           Json                       @default("[]")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  findings           SecurityFinding[]
  deliveries         SecurityDelivery[]

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([lastScannedAt])
}

// V2 team boundaries. Provider credentials remain on their original User connection.
model Organization {
  id                String                   @id @default(cuid())
  name              String
  personalForUserId String?                  @unique
  personalForUser   User?                    @relation("PersonalOrganization", fields: [personalForUserId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?                    @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revision          Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  members           OrganizationMember[]
  invitations       OrganizationInvitation[]
  audit             OrganizationAudit[]
  projects          SecurityProject[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  revision       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, createdAt])
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("member")
  tokenHash      String       @unique
  status         String       @default("pending")
  revision       Int          @default(0)
  expiresAt      DateTime
  createdById    String?
  createdBy      User?        @relation("OrganizationInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedById   String?
  acceptedBy     User?        @relation("OrganizationInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status, expiresAt])
}

model OrganizationAudit {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId            String?
  actor              User?        @relation("OrganizationAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId       String?
  targetUser         User?        @relation("OrganizationAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetInvitationId String?
  action             String
  reason             String       @default("")
  metadata           Json         @default("{}")
  createdAt          DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model SecurityAdvisory {
  adminReview IntelAdvisoryReview?
  id          String               @id
  aliases     String[]             @default([])
  data        Json
  fetchedAt   DateTime             @default(now())
  findings    SecurityFinding[]
}

model SecurityFinding {
  id               String                 @id @default(cuid())
  projectId        String
  project          SecurityProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  advisoryId       String
  advisory         SecurityAdvisory       @relation(fields: [advisoryId], references: [id])
  ecosystem        String
  packageName      String
  installedVersion String
  fixedVersion     String?
  riskSnapshot     Json                   @default("{}")
  status           String                 @default("open")
  note             String                 @default("")
  evidence         String                 @default("")
  firstSeenAt      DateTime               @default(now())
  lastSeenAt       DateTime               @default(now())
  resolvedAt       DateTime?
  remediation      Json                   @default("{}")
  remediationRevision Int                @default(0)
  events           SecurityFindingEvent[]

  @@unique([projectId, advisoryId, ecosystem, packageName, installedVersion], map: "SecurityFinding_match_key")
  @@index([projectId, status])
}

model SecurityFindingEvent {
  id        String          @id @default(cuid())
  findingId String
  finding   SecurityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  actorId   String?
  status    String
  note      String          @default("")
  evidence  String          @default("")
  remediation Json?
  createdAt DateTime        @default(now())

  @@index([findingId, createdAt])
}

model SecurityNotificationSettings {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model SecurityDelivery {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId         String?
  project           SecurityProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  eventKey          String           @unique
  subject           String
  body              String
  status            String           @default("pending")
  attempts          Int              @default(0)
  nextAttemptAt     DateTime         @default(now())
  claimedAt         DateTime?
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
}

// Additive provider records. Scalar owner/project IDs are checked at every service edge.
// Provider credentials are encrypted AES-256-GCM envelopes, never response fields.
model RepositoryConnection {
  owner            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources          ProjectRepositorySource[]
  id               String                    @id @default(cuid())
  userId           String
  provider         String
  providerUserId   String
  accountName      String
  installationId   String?
  installationAccountName String?
  repositorySelection String?
  status           String                    @default("connected")
  credentials      String?
  expiresAt        DateTime?
  validatedAt      DateTime?
  refreshLock      String?
  refreshStartedAt DateTime?
  error            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([userId, provider, providerUserId, installationId], map: "RepositoryConnection_owner_identity_installation_key")
  @@index([userId, createdAt])
}

model RepositoryConnectionAttempt {
  owner          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  id             String    @id @default(cuid())
  userId         String
  provider       String
  stateHash      String    @unique
  verifier       String
  installationId String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

model ProjectRepositorySource {
  baseline            Json?
  baselineCheckedAt   DateTime?
  baselineAttemptedAt DateTime?
  baselineError       String?
  baselineToken       String?
  baselineStartedAt   DateTime?
  owner               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             SecurityProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection          RepositoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  id                  String               @id @default(cuid())
  userId              String
  projectId           String               @unique
  connectionId        String
  provider            String
  repositoryId        String
  repositoryName      String
  repositoryUrl       String
  branch              String
  paths               String[]
  scope               String               @default("repository_inventory")
  paused              Boolean              @default(false)
  status              String               @default("idle")
  observedCommit      String?
  importedCommit      String?
  inventoryDigest     String?
  importedFiles       Json                 @default("[]")
  lastSyncedAt        DateTime?
  lastAttemptAt       DateTime?
  nextSyncAt          DateTime             @default(now())
  syncToken           String?
  syncStartedAt       DateTime?
  error               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([connectionId])
  @@index([provider, repositoryId])
  @@index([paused, nextSyncAt])
}

model SecurityPlaybookResponse {
  id              String                  @id @default(cuid())
  userId          String
  owner           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  project         SecurityProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  playbookId      String
  templateVersion String
  status          String                  @default("investigating")
  answers         Json                    @default("{}")
  checks          Json                    @default("{}")
  note            String                  @default("")
  evidence        String                  @default("")
  revision        Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  closedAt        DateTime?
  events          SecurityPlaybookEvent[]

  @@unique([projectId, playbookId])
  @@index([userId, updatedAt])
}

model SecurityPlaybookEvent {
  id         String                   @id @default(cuid())
  responseId String
  response   SecurityPlaybookResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?                    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  status     String
  note       String                   @default("")
  evidence   String                   @default("")
  answers    Json                     @default("{}")
  checks     Json                     @default("{}")
  createdAt  DateTime                 @default(now())

  @@index([responseId, createdAt])
}

model RepositoryWebhookDelivery {
  id             String    @id @default(cuid())
  provider       String
  deliveryId     String
  event          String
  repositoryId   String?
  installationId String?
  status         String    @default("pending")
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  error          String?

  @@unique([provider, deliveryId])
  @@index([status, receivedAt])
}

// Merge into the main Prisma schema; no account is needed for these records.
model PublicSubscriber {
  adminRevision      Int                       @default(0)
  id                 String                    @id @default(cuid())
  email              String                    @unique
  status             String                    @default("pending")
  topics             Json                      @default("[\"all\"]")
  confirmedAt        DateTime?
  lastRequestAt      DateTime                  @default(now())
  nextDigestAt       DateTime?
  lastCompiledAt     DateTime?
  unsubscribeVersion Int                       @default(1)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tokens             PublicSubscriptionToken[]
  deliveries         PublicFeedDelivery[]
  mailReceipts       PublicMailReceipt[]

  @@index([status, nextDigestAt])
}

model PublicSubscriptionToken {
  id           String           @id @default(cuid())
  subscriberId String
  subscriber   PublicSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tokenHash    String           @unique
  purpose      String
  topics       Json?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([subscriberId, purpose, createdAt])
  @@index([expiresAt])
}

model PublicFeedState {
  advisoryId  String   @id
  fingerprint String
  updatedAt   DateTime @updatedAt
}

model PublicFeedEvent {
  id          String   @id
  advisoryId  String
  fingerprint String
  data        Json
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PublicFeedDelivery {
  id                String           @id @default(cuid())
  subscriberId      String
  subscriber        PublicSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  eventKey          String           @unique
  items             Json
  subject           String
  status            String           @default("pending")
  attempts          Int              @default(0)
  nextAttemptAt     DateTime         @default(now())
  claimedAt         DateTime?
  providerMessageId String?          @unique
  error             String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([status, nextAttemptAt])
  @@index([subscriberId, createdAt])
}

model PublicMailWebhook {
  id                String    @id
  type              String
  providerMessageId String?
  status            String    @default("pending")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  processedAt       DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
}

model PublicMailReceipt {
  id           String           @id // Provider message id, including consent and management emails.
  subscriberId String
  subscriber   PublicSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([subscriberId])
}

// Dedicated v2 operator controls; Dotsama ADMIN role grants no access here.
model IntelAdminAudit {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  reason     String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model IntelAdvisoryReview {
  advisoryId   String           @id
  advisory     SecurityAdvisory @relation(fields: [advisoryId], references: [id], onDelete: Cascade)
  visibility   String           @default("published")
  guidance     String           @default("")
  note         String           @default("")
  revision     Int              @default(0)
  reviewedAt   DateTime?
  reviewedById String?
}

model IntelSourceControl {
  id            String    @id
  paused        Boolean   @default(false)
  revision      Int       @default(0)
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  health        String    @default("unknown")
  updatedAt     DateTime  @updatedAt
}

model IntelAdminJob {
  id             String                 @id @default(cuid())
  kind           String
  targetId       String?
  actorId        String?
  reason         String
  status         String                 @default("queued")
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  leaseToken     String?
  leaseStartedAt DateTime?
  error          String?
  activeKey      String?                @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  attemptRecords IntelAdminJobAttempt[]

  @@index([status, nextAttemptAt])
  @@index([kind, targetId, createdAt])
}

model IntelAdminJobAttempt {
  id         String        @id @default(cuid())
  jobId      String
  job        IntelAdminJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt    Int
  status     String
  error      String?
  startedAt  DateTime
  finishedAt DateTime?

  @@unique([jobId, attempt])
}
